# StorySpark Local — copy to .env and edit.

# ollama | openai | transformers
STORYSPARK_ENGINE=ollama

# Any model the chosen server knows. The default targets a Gemma 4 tag;
# use e.g. gemma3:12b, qwen2.5vl:7b or llava if that is what you pulled.
STORYSPARK_MODEL=gemma4:12b

# Ollama
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible servers (vLLM, llama.cpp, LM Studio, TGI)
STORYSPARK_BASE_URL=http://localhost:8080/v1
STORYSPARK_API_KEY=local

# Second child-safety review pass. Set to 0 only for local debugging.
STORYSPARK_SAFETY_PASS=1

# Request timeout in seconds.
STORYSPARK_TIMEOUT=120

# Comma-separated allowed browser origins for the API.
STORYSPARK_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080
