{
  "name": "StorySpark Local — AI for kids",
  "short_name": "StorySpark",
  "description": "Draw a hero, choose a lesson and play a gentle story or quest. Works offline on your own device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FFFDF3",
  "theme_color": "#FFD22E",
  "categories": ["education", "kids", "entertainment"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Start a story",
      "short_name": "Story",
      "url": "./play.html"
    },
    {
      "name": "Play a quest",
      "short_name": "Quest",
      "url": "./game.html"
    },
    {
      "name": "Family bookshelf",
      "short_name": "Family",
      "url": "./family.html#bookshelf"
    }
  ]
}
